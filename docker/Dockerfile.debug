FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src METRICS_PORT=9877
RUN apt-get update && apt-get install -y --no-install-recommends iptables util-linux ca-certificates curl iproute2 procps && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY src/ /app/src/
COPY requirements.txt /app/requirements.txt
EXPOSE 9877
USER 0
ENTRYPOINT ["python", "-m", "imds_tracker.main"]
